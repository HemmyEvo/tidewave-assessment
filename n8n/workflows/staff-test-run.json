{
  "id": "wf_staff_test_run",
  "name": "Staff Test Run",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "staff-test-run",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "id": "01948b83-0001-7000-8000-000000000001",
      "webhookId": "dc7c3c21-22b1-4762-8634-05debeed5a36",
      "name": "Webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst approved = {\n  'street-team-prospect': ['firstName', 'nextStepText', 'screeningUrl'],\n  'solace-intro': ['firstName', 'campaignUrl'],\n  'solace-confirmed': ['firstName', 'amountText', 'levelName']\n};\nif (!Object.prototype.hasOwnProperty.call(approved, body.templateKey)) {\n  throw new Error('Template is not approved or does not exist');\n}\nif (!body.variables || typeof body.variables !== 'object' || Array.isArray(body.variables)) {\n  throw new Error('Variables must be an object');\n}\nfor (const name of approved[body.templateKey]) {\n  if (typeof body.variables[name] !== 'string' || !body.variables[name].trim()) {\n    throw new Error(`Required template variable is missing: ${name}`);\n  }\n}\nreturn [{ json: { templateKey: body.templateKey, variables: body.variables, recipient: 'staff-test@tidewave.test', requestedBy: typeof body.requestedBy === 'string' ? body.requestedBy : 'staff' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "id": "01948b83-0001-7000-8000-000000000002",
      "name": "Validate Approved Test Request",
      "notes": "Accept approved templates and required fields only; ignore any requested recipient."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://leads:8081/templates/' + $json.templateKey + '/render' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ variables: $json.variables, test: true }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "id": "01948b83-0001-7000-8000-000000000003",
      "name": "Render Approved Test Template",
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred_tidewave_automation",
          "name": "Tidewave Automation"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "fromEmail": "hello@tidewave.test",
        "toEmail": "staff-test@tidewave.test",
        "subject": "={{ $json.subject }}",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        880,
        300
      ],
      "id": "01948b83-0001-7000-8000-000000000004",
      "name": "Send Test Email to Staff",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 1000,
      "credentials": {
        "smtp": {
          "id": "cred_mailpit_smtp",
          "name": "Mailpit SMTP"
        }
      },
      "notes": "Recipient is deliberately fixed to the assessment staff test mailbox."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, subject: $('Render Approved Test Template').first().json.subject, recipient: 'staff-test@tidewave.test' }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        300
      ],
      "id": "01948b83-0001-7000-8000-000000000005",
      "name": "Respond to Staff Test Request"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate Approved Test Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Approved Test Request": {
      "main": [
        [
          {
            "node": "Render Approved Test Template",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render Approved Test Template": {
      "main": [
        [
          {
            "node": "Send Test Email to Staff",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Test Email to Staff": {
      "main": [
        [
          {
            "node": "Respond to Staff Test Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none"
  },
  "active": false
}
