{
  "id": "wf_solace_events",
  "name": "Solace Avenue Events",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "solace-events",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "id": "01948b82-0001-7000-8000-000000000001",
      "webhookId": "5b7c1f1e-3a52-4d7e-9a61-0c2f6a3e1a02",
      "name": "Webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://leads:8081/__automation/events/verify",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Tidewave-Signature",
              "value": "={{ $('Webhook').first().json.headers['x-tidewave-signature'] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: $('Webhook').first().json.body }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ],
      "id": "01948b82-0001-7000-8000-000000000002",
      "name": "Verify Signed Event",
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred_tidewave_automation",
          "name": "Tidewave Automation"
        }
      },
      "notes": "Verify the engine HMAC before interpreting event data.",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "jsCode": "const event = $('Webhook').first().json.body;\nif (!event?.id || !['optin.created', 'payment.updated'].includes(event.type)) {\n  throw new Error('Unsupported or invalid Solace event');\n}\nconst state = $getWorkflowStaticData('global');\nstate.sentSolaceActions ||= {};\nconst actionKey = event.type === 'payment.updated' ? `payment-confirmed:${event.data?.paymentId}` : `optin:${event.id}`;\nif (actionKey.endsWith(':undefined')) throw new Error('Event is missing its payment ID');\nreturn [{ json: { eventId: event.id, eventType: event.type, actionKey, alreadySent: Boolean(state.sentSolaceActions[actionKey]), event } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
      "id": "01948b82-0001-7000-8000-000000000003",
      "name": "Normalize and Deduplicate",
      "notes": "Deduplicate opt-ins by event and confirmations by payment action."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "already-sent",
              "leftValue": "={{ $json.alreadySent }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        860,
        300
      ],
      "id": "01948b82-0001-7000-8000-000000000004",
      "name": "Already Sent"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, duplicate: true }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1080,
        180
      ],
      "id": "01948b82-0001-7000-8000-000000000005",
      "name": "Respond Duplicate"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "optin",
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "optin.created",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "optin.created"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "payment",
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "payment.updated",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "payment.updated"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1080,
        360
      ],
      "id": "01948b82-0001-7000-8000-000000000006",
      "name": "Route Event Type"
    },
    {
      "parameters": {
        "jsCode": "const event = $('Normalize and Deduplicate').first().json.event;\nconst data = event.data || {};\nconst email = typeof data.email === 'string' ? data.email.trim() : '';\nconst eligible = data.consent === true && String(data.source || '').toLowerCase() === 'artist' && email.toLowerCase().endsWith('.test');\nreturn [{ json: { eligible, email, firstName: data.firstName || 'there', participantId: data.participantId || '', campaignUrl: 'http://localhost:7080/campaigns/harmattan-sessions' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        180
      ],
      "id": "01948b82-0001-7000-8000-000000000007",
      "name": "Check Opt-in Consent",
      "notes": "Send only signed, consented artist opt-ins to the active campaign."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "eligible-optin",
              "leftValue": "={{ $json.eligible }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        180
      ],
      "id": "01948b82-0001-7000-8000-000000000008",
      "name": "Eligible Opt-in"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://leads:8081/templates/solace-intro/render",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ variables: { firstName: $('Check Opt-in Consent').first().json.firstName, campaignUrl: $('Check Opt-in Consent').first().json.campaignUrl }, test: false }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        120
      ],
      "id": "01948b82-0001-7000-8000-000000000009",
      "name": "Render Solace Intro",
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred_tidewave_automation",
          "name": "Tidewave Automation"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "fromEmail": "hello@tidewave.test",
        "toEmail": "={{ $('Check Opt-in Consent').first().json.email }}",
        "subject": "={{ $json.subject }}",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1980,
        120
