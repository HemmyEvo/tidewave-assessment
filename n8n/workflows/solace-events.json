      "waitBetweenTries": 1000,
      "credentials": {
        "smtp": {
          "id": "cred_mailpit_smtp",
          "name": "Mailpit SMTP"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const state = $getWorkflowStaticData('global');\nstate.sentSolaceActions ||= {};\nconst actionKey = $('Normalize and Deduplicate').first().json.actionKey;\nstate.sentSolaceActions[actionKey] = new Date().toISOString();\nreturn [{ json: { sent: true, actionKey } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        120
      ],
      "id": "01948b82-0001-7000-8000-000000000011",
      "name": "Mark Opt-in Delivered"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, sent: true }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2420,
        120
      ],
      "id": "01948b82-0001-7000-8000-000000000012",
      "name": "Respond Opt-in Sent"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, skipped: true, reason: 'consent_or_source' }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1760,
        300
      ],
      "id": "01948b82-0001-7000-8000-000000000013",
      "name": "Respond Opt-in Skipped"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://engine:8080/api/automation/payments/' + $('Normalize and Deduplicate').first().json.event.data.paymentId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        520
      ],
      "id": "01948b82-0001-7000-8000-000000000014",
      "name": "Verify Payment With Provider",
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred_tidewave_automation",
          "name": "Tidewave Automation"
        }
      },
      "notes": "Never use inbound status for confirmation; this API checks FakePay.",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "jsCode": "const payment = $input.first().json;\nconst email = payment.participant?.email || '';\nconst eligible = payment.verifiedWithProvider === true && payment.status === 'succeeded' && payment.campaign?.isOpen === true && email.toLowerCase().endsWith('.test');\nreturn [{ json: { eligible, id: payment.id, participant: payment.participant, amountText: payment.amountText, levelName: payment.level || 'Listener' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        520
      ],
      "id": "01948b82-0001-7000-8000-000000000015",
      "name": "Check Verified Confirmation",
      "notes": "Only provider-verified succeeded payments for open campaigns may be emailed."
