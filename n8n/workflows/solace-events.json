        "jsCode": "const state = $getWorkflowStaticData('global');\nstate.sentSolaceActions ||= {};\nconst actionKey = $('Normalize and Deduplicate').first().json.actionKey;\nstate.sentSolaceActions[actionKey] = new Date().toISOString();\nreturn [{ json: { sent: true, paymentId: $('Check Verified Confirmation').first().json.id, actionKey } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
